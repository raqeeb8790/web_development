<!DOCTYPE html>
<html>
<head>
    <title>border</title>
    <style>
        h1{
            border-style: double;
            border-width: 5px;
            border-color: red;
        }
        h2{
            border-style: dashed ridge dotted double;
            border-width: 6px;
            border-color: blue;
        }
        h3{
            border-top: solid;
            border-color: brown;
            border-width: 5px;

            border-right: double;
            border-color: red;
            border-width: 5px;

            border-bottom: dotted;
            border-color: black;
            border-width: 5px;

            border-left: ridge;
            border-color: blueviolet;
            border-width: 6px;

        }
    </style>
</head>
<body >
    <h1>Welcome to html</h1>
    <h2> hello</h2>
    <h3>lets create all the styles</h3>
</body>
</html>
